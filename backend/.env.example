# Google Gemini API Configuration for Agentic Customer Support
# If GEMINI_API_KEY is not set, the system automatically runs offline via LangGraph deterministic fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model selection
GEMINI_MODEL=gemini-3.5-flash-lite

# Model sampling temperature (0.1 recommended for precise tool calling)
LLM_TEMPERATURE=0.1
