# Google Gemini API Configuration for Agentic Customer Support
# If GEMINI_API_KEY is not set, system automatically falls back to rule-based classification.
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model selection (e.g., gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
LLM_MODEL=gemini-1.5-flash

# Model sampling temperature (0.0 recommended for deterministic classification)
LLM_TEMPERATURE=0.0
